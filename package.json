		"eslint": "^10",
		"globals": "^17.14.0",
		"mongodb": "^7",
		"prettier": "^3.10.1",
		"tsdown": "^0.23.7",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"unrun": "^0.3.1",
		"vite": "^8.3.8",
		"vitest": "^5"
	},
	"dependencies": {
		"empty-php": "^3",
		"querystringify": "^2"
	},
	"peerDependencies": {
		"mongodb": "^7"
	},
	"bin": {
		"mongodb-create-indices": "./bin/mongodb-sync-indices.js"
